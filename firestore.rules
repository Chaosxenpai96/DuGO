rules_version = '2';

// DuGO's Firestore rules.
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
// The data model:
//   users/{uid}                 - a profile
//   requests/{requestId}        - a blood request
//   conversations/{id}          - a chat between two people
//   conversations/{id}/messages/{msgId}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- profiles ----------
    // Any signed-in user can read profiles: the map needs to see other people's
    // name, blood type and position to place their pin. Only the owner changes
    // their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- blood requests ----------
    // Every signed-in user can read the feed and post a request. Only the person
    // who posted it can change or remove it.
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.resource.data.posterUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
                            resource.data.posterUid == request.auth.uid;
    }

    // ---------- conversations ----------
    // A conversation's id is the two users' uids joined by an underscore, so
    // both of them work out the same document.
    match /conversations/{conversationId} {

      // Who is in this conversation. On a write this is the incoming data; on a
      // read it is what is already stored.
      function participants() {
        return request.auth != null &&
               request.auth.uid in request.resource.data.participantIds;
      }

      function storedParticipants() {
        return request.auth != null &&
               request.auth.uid in resource.data.participantIds;
      }

      // The chat list is found with whereArrayContains on participantIds.
      // Firestore proves this rule for each document in the result, so a
      // signed-in user only ever sees the chats they are part of.
      allow read: if storedParticipants();

      // A conversation is created when the first message is sent, so the
      // creator has to be one of the two participants.
      allow create: if participants();

      // Updating the summary marks it read; only a participant may do that.
      allow update: if storedParticipants();

      allow delete: if false;

      // ---------- messages ----------
      match /messages/{messageId} {
        function chatParticipants() {
          return request.auth != null &&
                 request.auth.uid in get(/databases/$(database)/documents/
                     conversations/$(conversationId)).data.participantIds;
        }

        allow read: if chatParticipants();

        allow create: if request.auth != null &&
                      request.resource.data.senderUid == request.auth.uid &&
                      chatParticipants();

        // Only the sender can edit their own message. The receiver also needs
        // to update it to mark it as read.
        allow update: if chatParticipants() &&
                      (request.resource.data.senderUid == request.auth.uid ||
                       resource.data.senderUid == request.auth.uid);

        allow delete: if request.auth != null &&
                      resource.data.senderUid == request.auth.uid;
      }
    }

    // Anything else is closed off.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
