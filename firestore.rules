rules_version = '2';

// DuGO's Firestore rules (fixed).
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
// Data model:
//   users/{uid}                 - a profile
//   requests/{requestId}        - a blood request
//   events/{eventId}            - a blood donation drive (shown as the featured banner)
//   conversations/{id}          - a chat between two people (id = uidA_uidB)
//   conversations/{id}/messages/{msgId}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- profiles ----------
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- blood requests ----------
    // The poster can update their own request, which is how "Mark as Done"
    // sets fulfilled = true.
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.resource.data.posterUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
                            resource.data.posterUid == request.auth.uid;
    }

    // ---------- blood donation drives ----------
    // Read-only from the app. Add or edit drives in the Firebase console.
    // Fields: title (string), date (number, millis), location (string),
    //         description (string, optional)
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------- conversations ----------
    match /conversations/{conversationId} {

      // Membership is read from the document id (uidA_uidB), so it works
      // even before the conversation document exists.
      function inConversationId() {
        return request.auth != null &&
               request.auth.uid in conversationId.split('_');
      }

      // Chat list query (whereArrayContains on participantIds) still works
      // because stored participants are checked when the document exists.
      allow read: if request.auth != null &&
                  (resource == null
                   ? inConversationId()
                   : request.auth.uid in resource.data.participantIds);

      allow create: if inConversationId() &&
                    request.auth.uid in request.resource.data.participantIds;

      // Participants may update the summary, but not change who is in the chat.
      allow update: if inConversationId() &&
                    request.auth.uid in resource.data.participantIds &&
                    request.resource.data.participantIds == resource.data.participantIds;

      allow delete: if false;

      // ---------- messages ----------
      match /messages/{messageId} {

        allow read: if inConversationId();

        allow create: if inConversationId() &&
                      request.resource.data.senderUid == request.auth.uid;

        // Sender can edit their own message. The other participant can only
        // change the read fields. Rename 'read'/'readAt' to match your model.
        allow update: if inConversationId() &&
                      request.resource.data.senderUid == resource.data.senderUid &&
                      (resource.data.senderUid == request.auth.uid ||
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read', 'readAt']));

        allow delete: if request.auth != null &&
                      resource.data.senderUid == request.auth.uid;
      }
    }

    // Anything else is closed off.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
