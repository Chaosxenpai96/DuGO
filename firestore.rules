rules_version = '2';

// DuGO's Firestore rules.
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
// The data model:
//   users/{uid}                 - a profile
//   requests/{requestId}        - a blood request
//   conversations/{id}          - a chat between two people
//   conversations/{id}/messages/{msgId}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- profiles ----------
    // A profile is readable by anyone signed in (the map needs to show donors),
    // but only its owner can change it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---------- blood requests ----------
    // Anyone signed in can read and post a request. Only the person who posted
    // it can change or remove it.
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.resource.data.posterUid == request.auth.uid;
      allow update, delete: if request.auth != null &&
                            resource.data.posterUid == request.auth.uid;
    }

    // ---------- conversations ----------
    // A conversation's id is the two users' uids joined by an underscore, so
    // both of them can work out the same document.
    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth != null &&
               request.auth.uid in resource.data.participantIds;
      }

      // The list of chats is found with whereArrayContains on participantIds,
      // so the query has to be allowed for the signed-in user.
      allow read: if request.auth != null &&
                  request.auth.uid in resource.data.participantIds;

      // A conversation is created when the first message is sent, so the
      // creator has to be one of the two participants.
      allow create: if request.auth != null &&
                    request.auth.uid in request.resource.data.participantIds;

      allow update: if isParticipant();
      allow delete: if false;

      // ---------- messages ----------
      match /messages/{messageId} {
        allow read: if request.auth != null &&
                    request.auth.uid in get(/databases/$(database)/documents/
                        conversations/$(conversationId)).data.participantIds;

        allow create: if request.auth != null &&
                      request.resource.data.senderUid == request.auth.uid;

        // Only the sender can edit or delete their own message. Reading it
        // marks it as read, which the sender is allowed to do too.
        allow update: if request.auth != null &&
                      (request.resource.data.senderUid == request.auth.uid ||
                       resource.data.senderUid == request.auth.uid);

        allow delete: if request.auth != null &&
                      resource.data.senderUid == request.auth.uid;
      }
    }

    // Anything else is closed off.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
